alert dns $HOME_NET any -> any 53 (msg:"SOC LAB DNS marker"; flow:to_server; dns.query; content:"marker.lab.test"; nocase; startswith; endswith; sid:1000001; rev:1;)
alert http $HOME_NET any -> any any (msg:"SOC LAB HTTP marker"; flow:established,to_server; http.uri; content:"/soc-lab-marker"; startswith; endswith; sid:1000002; rev:1;)
