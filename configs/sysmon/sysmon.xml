<!-- Lab configuration inspired by SwiftOnSecurity/sysmon-config. See SOURCES.md. -->
<Sysmon schemaversion="4.90">
  <HashAlgorithms>SHA256</HashAlgorithms>
  <EventFiltering>
    <ProcessCreate onmatch="exclude" />
    <RuleGroup name="PowerShell network connections" groupRelation="or">
      <NetworkConnect onmatch="include">
        <Image condition="end with">\powershell.exe</Image>
        <Image condition="end with">\pwsh.exe</Image>
      </NetworkConnect>
    </RuleGroup>
    <RuleGroup name="PowerShell files in the lab" groupRelation="and">
      <FileCreate onmatch="include">
        <TargetFilename condition="contains">\SOC-Lab\</TargetFilename>
        <TargetFilename condition="end with">.ps1</TargetFilename>
      </FileCreate>
    </RuleGroup>
    <DnsQuery onmatch="exclude" />
  </EventFiltering>
</Sysmon>
