{"rule_id":"soc-lab-powershell-marker","name":"SOC Lab PowerShell marker","description":"Confirms that the benign lab marker appears in PowerShell script block telemetry.","index":["logs-windows.powershell_operational-lab"],"type":"query","language":"kuery","query":"event.code : \"4104\" and (powershell.file.script_block_text : \"Write-Output 'SOC-LAB-MARKER'\" or winlog.event_data.ScriptBlockText : \"Write-Output 'SOC-LAB-MARKER'\")","risk_score":21,"severity":"low","interval":"1m","from":"now-3m","to":"now","enabled":false,"actions":[],"author":["ngduyyy05"],"false_positives":["Approved activity in the isolated lab"],"tags":["SOC lab"],"max_signals":100,"threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0002","name":"Execution","reference":"https://attack.mitre.org/tactics/TA0002/"},"technique":[{"id":"T1059","name":"Command and Scripting Interpreter","reference":"https://attack.mitre.org/techniques/T1059/","subtechnique":[{"id":"T1059.001","name":"PowerShell","reference":"https://attack.mitre.org/techniques/T1059/001/"}]}]}]}
{"rule_id":"soc-lab-failed-remote-interactive","name":"Failed Remote Interactive Logon","description":"Flags a Windows RemoteInteractive authentication failure for triage.","index":["logs-system.security-lab"],"type":"query","language":"kuery","query":"event.code : \"4625\" and winlog.event_data.LogonType : \"10\"","risk_score":21,"severity":"low","interval":"1m","from":"now-3m","to":"now","enabled":false,"actions":[],"author":["ngduyyy05"],"false_positives":["A legitimate user mistypes a password"],"tags":["SOC lab"],"max_signals":100,"threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0006","name":"Credential Access","reference":"https://attack.mitre.org/tactics/TA0006/"},"technique":[{"id":"T1110","name":"Brute Force","reference":"https://attack.mitre.org/techniques/T1110/","subtechnique":[{"id":"T1110.001","name":"Password Guessing","reference":"https://attack.mitre.org/techniques/T1110/001/"}]}]}]}
{"rule_id":"soc-lab-suricata-markers","name":"SOC Lab Suricata marker","description":"Verifies ingestion of the local DNS and HTTP marker signatures.","index":["logs-suricata.eve-lab"],"type":"query","language":"kuery","query":"suricata.eve.alert.signature_id : (1000001 or 1000002)","risk_score":21,"severity":"low","interval":"1m","from":"now-3m","to":"now","enabled":false,"actions":[],"author":["ngduyyy05"],"false_positives":["Approved activity in the isolated lab"],"tags":["SOC lab"],"max_signals":100}
